# Copy to .env (git-ignored) and fill in the key. Never commit a real .env.
OpenRouter_Key=

# Models (defaults shown; they are also the code defaults, see submission/archive_qa/config.py)
LLM_MODEL_PRIMARY=anthropic/claude-haiku-5.5
LLM_MODEL_ESCALATION=anthropic/claude-sonnet-5.5

# Primary: temperature 0, json_schema strict, reasoning off. Escalation: reasoning "minimal" (mandatory for Sonnet).
LLM_MAX_TOKENS=400
LLM_REASONING=none
LLM_ESCALATION_MAX_TOKENS=1500
LLM_ESCALATION_REASONING=minimal

# Provider pin: provider.order=[...], allow_fallbacks=false, require_parameters=false.
# Do NOT turn require_parameters on: every Anthropic request then returns HTTP 404.
LLM_PROVIDER=Anthropic

LLM_CONCURRENCY=8
LLM_BUDGET_USD=3.00

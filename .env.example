# Copy to .env and fill in. Never commit .env.

# One of: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
# Optional: OpenAI-compatible endpoint (only used when LLM_PROVIDER=openai)
LLM_BASE_URL=

# Prices in USD per 1M tokens for LLM_MODEL (check the provider's pricing page)
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0

# Limits
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_ATTEMPTS=4
LLM_RETRY_MAX_WAIT=30

# Ingest
RENDER_DPI=150
IMAGE_MAX_SIDE=1600

# Copy to .env.local for local overrides (.env.local is git-ignored).
#
# VITE_ variables are compiled into the public JavaScript bundle: anyone can read them.
# They must NEVER hold secrets (no OpenRouter key, no tokens). The model key lives only on the API server.
#
# Base URL of the Well Archive API (web/server). Default when unset: http://localhost:8000
VITE_API_URL=http://localhost:8000
